          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 50,
          "spss": 1,
          "refId": "A",
          "query": "{resource.service.name=\"demo-web\" && span.page.route=~\"$route\" && name=\"cwv.lcp\" && duration > 2.5s} | select(span.cwv.lcp.target, span.cwv.lcp.element_render_delay, span.cwv.lcp.time_to_first_byte)"
        }
