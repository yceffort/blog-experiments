    {
      "type": "timeseries",
      "title": "LCP final vs quiet provisional",
      "description": "cwv.lcp is the value web-vitals finalized on first input or hidden, one per page. cwv.lcp.quiet is the provisional value this code records whenever the candidate stays unchanged for 3 seconds, so a page can have several. Only the final value goes into the Mimir histogram.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"demo-web\" && span.page.route=~\"$route\" && (name=\"cwv.lcp\" || name=\"cwv.lcp.quiet\")} | count_over_time() by (name)",
          "metricsQueryType": "range",
          "step": "5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
