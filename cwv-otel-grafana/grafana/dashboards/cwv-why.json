{
  "uid": "cwv-why",
  "title": "CWV root cause analysis (Tempo)",
  "tags": [
    "cwv"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "route",
        "type": "custom",
        "query": ".*,home,product",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          },
          {
            "text": "home",
            "value": "home",
            "selected": false
          },
          {
            "text": "product",
            "value": "product",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "What is the LCP element",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "LCP count by element",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"demo-web\" && span.page.route=~\"$route\" && name=\"cwv.lcp\"} | count_over_time() by (span.cwv.lcp.target)",
          "metricsQueryType": "range",
          "step": "5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 80,
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "LCP p75 by element",
      "description": "The span duration is the LCP value, so the duration quantile is the LCP quantile. Tempo returns 0 for the quantile of an interval with no samples, so a 0 here is an empty interval, not a value.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"demo-web\" && span.page.route=~\"$route\" && name=\"cwv.lcp\"} | quantile_over_time(duration, .75) by (span.cwv.lcp.target)",
          "metricsQueryType": "range",
          "step": "5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
