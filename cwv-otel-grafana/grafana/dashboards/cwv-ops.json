{
  "uid": "cwv-ops",
  "title": "CWV operations (Mimir)",
  "tags": [
    "cwv"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "source",
        "type": "custom",
        "description": "cwv-gateway: the gateway keeps the latest value per measurement and finalizes it after 30 minutes without updates, so values show up 30 minutes late. LCPs that only ever sent a provisional (quiet) value go to cwv_lcp_provisional and are not included here. demo-web: the control group the browser sent as delta (loses samples under concurrent writers, experiments/e10).",
        "query": "cwv-gateway,demo-web",
        "options": [
          {
            "text": "cwv-gateway",
            "value": "cwv-gateway",
            "selected": true
          },
          {
            "text": "demo-web",
            "value": "demo-web",
            "selected": false
          }
        ],
        "current": {
          "text": "cwv-gateway",
          "value": "cwv-gateway"
        }
      },
      {
        "name": "route",
        "label": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(cwv_lcp_milliseconds_count{job=\"$source\"}, page_route)",
          "refId": "route"
        },
        "definition": "label_values(cwv_lcp_milliseconds_count{job=\"$source\"}, page_route)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "How slow is it now (p75 over the selected range)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "LCP p75",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.75, sum by (le) (increase(cwv_lcp_milliseconds_bucket{job=\"$source\", page_route=~\"$route\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
